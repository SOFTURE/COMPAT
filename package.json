{
  "name": "@softure-ai/compat",
  "version": "0.0.0",
  "private": true,
  "description": "Backward-compatibility check between two git refs: OpenAPI, SQL migrations, seeds, persisted enums, configuration and message contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/COMPAT.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:pack": "vitest run --dir test/pack --exclude=none",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@softure-ai/skills": "^0.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
